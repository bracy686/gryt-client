{
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ES2020",
    "lib": ["ES2020"],
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["node"]
  },
  // The hotkey grammar and desktop window preferences are shared with the renderer.
  // Both projects are noEmit, so checking them twice keeps both sides in agreement.
  "include": ["vite.config.ts", "electron/**/*.ts", "src/lib/hotkeys.ts", "src/lib/windowSettings.ts"]
}
